<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MODEL STRUCTURE INSPECTOR"
        android:textColor="@color/text_accent"
        android:textStyle="bold"
        android:textSize="13sp"
        android:letterSpacing="0.04"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_console_rounded"
        android:padding="12dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvMatrixContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/console_text"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="Loading model..." />
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
