<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inference Strategy Selection:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1A237E"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgStrategySelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/rbStrategyBoth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Both Strategies (Side-by-Side Comparison)"
                android:textSize="13sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbStrategyKnn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strategy 1: Nearest Centroid / k-NN"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbStrategyFuzzy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strategy 2: Fuzzy 3D Matrix"
                android:textSize="13sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="14dp" />

        <!-- Survey Iterations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Survey Iteration Count (Total Scans per Spot):"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editSurveyCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 50"
            android:layout_marginBottom="12dp" />

        <!-- Train / Test Split Percentage -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Held-Out Test Split (% of scans for testing):"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editTestSplitPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 30 (35 build / 15 test)"
            android:layout_marginBottom="14dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="14dp" />

        <!-- Auto-Calibration Mode -->
        <CheckBox
            android:id="@+id/cbAutoCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Enable Auto-Calibration\n(Extend surveying until accuracy target is met)"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#1A237E"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutAutoCalibSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8EAF6"
            android:padding="10dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-Calibration Target Accuracy (%):"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editAutoCalibTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="e.g. 80"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Max Extra Scans Limit (0 = Unlimited):"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editAutoCalibMaxLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="0 for Unlimited, or e.g. 50"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Benchmark Strategy for Auto-Calibration:"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rgAutoCalibStrategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbAutoCalibFuzzy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fuzzy Matrix (Strategy 2)"
                    android:checked="true"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbAutoCalibKnn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nearest Centroid (Strategy 1)"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Locating Iteration Count (Scans for Where Am I):"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editLocateCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 10"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="k-NN Matching Parameter (k = 1, 3, 5...):"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/editKnnK"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 1" />

    </LinearLayout>
</ScrollView>
