<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inference Strategy Selection"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/text_accent"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rgStrategySelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_tonal"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbStrategyBoth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="k-NN vs Fuzzy Matrix (Side-by-Side)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbStrategyKnn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strategy 1: Nearest Centroid / k-NN"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbStrategyFuzzy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strategy 2: Fuzzy 3D Matrix"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbStrategyPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strategy 3: Cross-Device Pattern Matching"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbStrategyMamdani"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Strategy 4: Mamdani Fuzzy System (FIS)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbStrategyAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All 4 Strategies (Side-by-Side Comparison)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_subtle"
            android:layout_marginBottom="16dp" />

        <!-- Survey Iterations -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Survey Iteration Count (Total Scans per Spot)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editSurveyCount"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="number"
            android:hint="e.g. 50"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="14dp" />

        <!-- Train / Test Split Percentage -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Held-Out Test Split (% of scans for testing)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editTestSplitPercent"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="number"
            android:hint="e.g. 30 (35 build / 15 test)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_subtle"
            android:layout_marginBottom="16dp" />

        <!-- Auto-Calibration Mode -->
        <CheckBox
            android:id="@+id/cbAutoCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ Enable Auto-Calibration\n(Extend surveying until accuracy target is met)"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/text_accent"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/layoutAutoCalibSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_tonal"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-Calibration Target Accuracy (%)"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editAutoCalibTarget"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:inputType="number"
                android:hint="e.g. 80"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Max Extra Scans Limit (0 = Unlimited)"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/editAutoCalibMaxLimit"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:inputType="number"
                android:hint="0 for Unlimited, or e.g. 50"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Benchmark Strategy for Auto-Calibration"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rgAutoCalibStrategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbAutoCalibFuzzy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fuzzy Matrix (Strategy 2)"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbAutoCalibKnn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nearest Centroid (Strategy 1)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbAutoCalibPattern"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cross-Device Pattern (Strategy 3)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbAutoCalibMamdani"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mamdani FIS (Strategy 4)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_subtle"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Locating Iteration Count (Scans for Where Am I)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editLocateCount"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="number"
            android:hint="e.g. 10"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input_rounded"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="k-NN Matching Parameter (k = 1, 3, 5...)"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editKnnK"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="number"
            android:hint="e.g. 1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input_rounded" />

    </LinearLayout>
</ScrollView>
