<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wi_fi_fingerprint_scanner"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Settings"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSettingsSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Params: Survey=10 | Locate=10 | k-NN=1 | Filter=6"
        android:textSize="12sp"
        android:textColor="#555555"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/editSpotName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_spot_label_e_g_spot_1" />

    <Button
        android:id="@+id/btnSurvey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/_1_record_survey_sample"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnLocate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/_2_where_am_i_k_nn_match"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnClearData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear All Saved Data (DB)"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#F0F0F0"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logs will appear here..."
            android:textColor="@color/black"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>