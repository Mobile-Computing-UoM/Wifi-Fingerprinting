<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutExperimentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Header Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E8EAF6"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvExpHeaderStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Automated Experiment Runner"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1A237E" />

        <Button
            android:id="@+id/btnExpExportCsv"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📤 Export"
            android:textSize="11sp"
            android:backgroundTint="#00796B"
            android:textColor="#FFFFFF"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <Button
            android:id="@+id/btnExpClearCsv"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🗑️ Clear"
            android:textSize="11sp"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

    <!-- Configuration Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EDE7F6"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <!-- Row 1: Separation & Spot Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sep:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#311B92"
                android:layout_marginEnd="4dp" />

            <Spinner
                android:id="@+id/spinnerExpSeparation"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spot:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#311B92"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp" />

            <Spinner
                android:id="@+id/spinnerExpSpot"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.2"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- Row 2: Coordinate overrides & Sample counts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X(m):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="2dp" />

            <EditText
                android:id="@+id/editExpCoordX"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="0.0"
                android:textSize="12sp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:inputType="numberDecimal|numberSigned" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Y(m):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="2dp" />

            <EditText
                android:id="@+id/editExpCoordY"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="0.0"
                android:textSize="12sp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:inputType="numberDecimal|numberSigned" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trials(M):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="2dp" />

            <EditText
                android:id="@+id/editExpTrials"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:text="20"
                android:textSize="12sp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:inputType="number" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans(n):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="2dp" />

            <EditText
                android:id="@+id/editExpScans"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:text="10"
                android:textSize="12sp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:inputType="number" />
        </LinearLayout>

        <!-- Start & Stop Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnExpStart"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="▶️ Start Experiment Loop"
                android:textStyle="bold"
                android:textSize="13sp"
                android:backgroundTint="#3F51B5"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnExpStop"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="⏹️ Abort"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Card (Visible during scan execution) -->
    <LinearLayout
        android:id="@+id/layoutExpProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E8EAF6"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvExpProgressTrial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trial 1 / 20"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#1A237E" />

            <TextView
                android:id="@+id/tvExpProgressScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan 1 / 10"
                android:textSize="12sp"
                android:textColor="#0D47A1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbExpScan"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#1976D2" />
    </LinearLayout>

    <!-- Live Performance Stats Card -->
    <LinearLayout
        android:id="@+id/layoutExpStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F1F8E9"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚖️ Session Performance Summary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#33691E" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvExpKnnStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="k-NN: --% (Mean Err: --m)"
                android:textSize="11sp"
                android:textColor="#1B5E20" />

            <TextView
                android:id="@+id/tvExpFuzzyStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fuzzy: --% (Mean Err: --m)"
                android:textSize="11sp"
                android:textColor="#1B5E20" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tvExpEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No experiment results recorded yet.\nSelect your test spot, separation, and tap 'Start Experiment Loop'."
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="#757575"
        android:padding="20dp"
        android:visibility="gone" />

    <!-- Results History RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExpHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

