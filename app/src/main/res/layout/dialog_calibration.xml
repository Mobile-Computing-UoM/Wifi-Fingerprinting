<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 One-Spot Antenna Calibration"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/text_accent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stand at a known physical spot. The app will measure the signal contrast and compute this phone's hardware dB offset relative to the imported survey phone."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Current Physical Spot"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <Spinner
        android:id="@+id/spinnerCalibSpot"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_rounded"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvCalibInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ Will take 10 scans and compute median antenna bias across shared APs."
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:background="@drawable/bg_card_tonal"
        android:padding="10dp" />

</LinearLayout>
